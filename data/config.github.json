{
  "ai": {
    "provider": "openai",
    "model": "kimi-k3",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://api.moonshot.ai/v1",
    "temperature": 1,
    "max_tokens": 50000,
    "throttle_sec": 0,
    "analysis_concurrency": 4,
    "enrichment_concurrency": 2,
    "languages": [
      "zh"
